msgstr "Не надет"

# Touch inventory: reviewed mobile equipment UI.
msgid "TOUCH_DRAG_HINT"
msgstr "Удерживай вещь и перетащи её в ячейку."

# Touch inventory: reviewed mobile equipment UI.
msgid "TOUCH_QUICK_LABEL"
msgstr "Быстрые слоты · 1–0"

# Touch inventory: reviewed mobile equipment UI.
msgid "TOUCH_EMPTY_SLOT"
msgstr "Пусто"

# Touch inventory: reviewed mobile equipment UI.
msgid "TOUCH_MOVE_FAILED"
msgstr "Сюда нельзя переложить эту вещь."

