# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Preserve the owner's original lore attachment byte-for-byte.
docs/narrative/LORE_ORIGINAL.txt -text whitespace=-blank-at-eol,cr-at-eol

# Keep upstream CC0 model payloads and license byte-for-byte.
assets/environment/village-props-v1/*.bin binary
assets/environment/village-props-v1/*.gltf -text
assets/environment/village-props-v1/License_Standard.txt -text -whitespace

# Preserve the upstream audio license verbatim, including its original line endings.
art/audio/village-v1/Kenney-License.txt -text -whitespace
